{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // packages/engine/src/*.ts import each other with the .ts extension so the
    // engine can be run directly with `node`. This file compiles those sources
    // too (see `include`), so the extension has to be legal here as well.
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    // The engine is not a published package yet, so each module is mapped by
    // hand. Subpaths rather than a wildcard: the engine's files import each
    // other as "./types.ts", and a wildcard here would offer a second name for
    // the same file — two module identities for one module.
    "paths": {
      "@/*": ["./*"],
      "@commitandrun/engine": ["../../packages/engine/src/types.ts"],
      "@commitandrun/engine/input": ["../../packages/engine/src/input.ts"],
      "@commitandrun/engine/plan": ["../../packages/engine/src/plan.ts"],
      "@commitandrun/engine/select": ["../../packages/engine/src/select.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "../../packages/engine/src/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
