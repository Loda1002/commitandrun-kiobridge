# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Env / secrets
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
yarn-error.log*
.claude/logs/

# KioBridge Simulation Kit — distributed ZIP, everyone extracts their own copy.
# Only our team workspace (participant.ts + golden submission JSONs) is tracked.
kit/*
!kit/workspace/
kit/workspace/**/node_modules/

# Submission output is regenerated by participant:package
kit/submission-output/

# Rollback copy of the previous kit release, kept locally only
kit-v514/

# Mission videos and demo recordings — these go to the Blaybus workspace,
# not into git. Binaries stay in history forever even after deletion.
*.mp4
*.mov
*.avi
*.mkv
*.webm

# Scratch
*.tmp
scratch/
