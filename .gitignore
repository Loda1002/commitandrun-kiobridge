# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Env / secrets
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
yarn-error.log*
.claude/logs/

# Local Claude Code state — sqlite left behind by plugins unrelated to this
# project. Nothing here is ours and none of it is reproducible on another
# machine, so a stray `git add -A` must not sweep it in.
.claude/data/

# KioBridge Simulation Kit — distributed ZIP, everyone extracts their own copy.
# Only our team workspace (participant.ts + golden submission JSONs) is tracked.
kit/*
!kit/workspace/
kit/workspace/**/node_modules/

# Submission output is mostly regenerated by participant:package, but two of the
# eight files are not: README.md and MANUAL_REVIEW_CHECKLIST.md are written by
# hand and the packager overwrites them with blank templates on every run. Until
# now the filled copies lived on one laptop only. Track the folder so a lost
# machine does not take the submission with it, and so a repackage that wipes
# those two files shows up as a diff instead of going unnoticed.
# Note: `kit/*` above already excludes this directory, so removing a rule is not
# enough -- the folder has to be negated back in, the same way kit/workspace/ is.
# Only our team folder is ours; the .gitkeep and README.md sitting next to it ship
# with the kit, so re-exclude everything and negate COMMITANDRUN back in.
!kit/submission-output/
kit/submission-output/*
!kit/submission-output/COMMITANDRUN/

# The emailed archive is just the eight files above, rebuilt in one command:
#   Compress-Archive -Path .\kit\submission-output\COMMITANDRUN\* -DestinationPath .\COMMITANDRUN_KioBridge_Technical_Submission.zip -Force
COMMITANDRUN_KioBridge_Technical_Submission.zip

# Rollback copies of previous kit releases, kept locally only.
# WARNING: kit-v516-rc4/node_modules/@kiobridge/ holds 12 junctions whose absolute
# targets now resolve into the CURRENT kit/. Never delete these folders recursively
# without removing the reparse points first -- see pm/99_HANDOFF.md.
kit-v514/
kit-v516-rc4/

# Local snapshots taken before a kit swap
backup/

# Mission videos and demo recordings — these go to the Blaybus workspace,
# not into git. Binaries stay in history forever even after deletion.
*.mp4
*.mov
*.avi
*.mkv
*.webm

# Scratch
*.tmp
scratch/
